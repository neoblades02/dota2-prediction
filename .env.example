# Copy to .env and fill in. Never commit real keys.

# Database. Empty = local SQLite at data/dota_predictor.db.
# A plain postgresql:// URL works (it is pointed at the psycopg 3 driver automatically).
# DOTA_DATABASE_URL takes precedence over DATABASE_URL when both are set.
DATABASE_URL=

# Dashboard password (HTTP basic auth, any username). Required by `dota-predictor serve`.
DOTA_UI_PASSWORD=

# PandaScore token: upcoming/running/finished schedule. Without it, matches appear
# only once their lobby is live on OpenDota.
DOTA_PANDASCORE_API_KEY=

# OpenDota API key (optional; raises the ~3,000 requests/day anonymous limit)
DOTA_OPENDOTA_API_KEY=
